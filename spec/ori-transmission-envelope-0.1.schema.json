{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpermit.dev/spec/ori-transmission-envelope-0.1.schema.json",
  "title": "ORI Transmission Envelope v0.1 Draft",
  "description": "Business package an applicant sends for one application: parties, purpose, hashed manifest, privacy handling and a separate receipt. Receipt is delivery evidence, not completeness and not approval. See spec/transmission-envelope-0.1-draft.md.",
  "type": "object",
  "required": [
    "@context",
    "@id",
    "@type",
    "record_profile",
    "draft_status",
    "is_approval",
    "label",
    "application_ref",
    "created_at",
    "license",
    "description",
    "sender",
    "receiver",
    "correlation_id",
    "idempotency_key",
    "purpose",
    "submitted_at",
    "representation",
    "manifest",
    "privacy",
    "receipt"
  ],
  "properties": {
    "@context": {
      "type": "object",
      "description": "Must equal the pinned context vocab/ori-lifecycle-records-0.1.context.json (checked semantically)."
    },
    "@id": {
      "type": "string",
      "pattern": "^urn:ori:submission:\\S+$"
    },
    "@type": {
      "const": "TransmissionEnvelope"
    },
    "record_profile": {
      "const": "ori-transmission-envelope-0.1"
    },
    "draft_status": {
      "const": "DRAFT"
    },
    "is_approval": {
      "const": false
    },
    "label": {
      "const": "Reviewer evidence, not approval"
    },
    "application_ref": {
      "type": "string",
      "pattern": "^urn:ori:application:\\S+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "simulation": {
      "type": "boolean"
    },
    "wasGeneratedBy": {
      "$ref": "#/$defs/activity"
    },
    "wasDerivedFrom": {
      "$ref": "#/$defs/iri"
    },
    "wasAttributedTo": {
      "$ref": "#/$defs/iri"
    },
    "sender": {
      "type": "object",
      "required": [
        "agent_ref",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_ref": {
          "$ref": "#/$defs/iri"
        },
        "role": {
          "enum": [
            "applicant",
            "design_professional",
            "intake",
            "authority",
            "system",
            "other"
          ]
        },
        "native_role_label": {
          "type": "string",
          "maxLength": 80
        },
        "classifications": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/classification"
          }
        }
      }
    },
    "receiver": {
      "type": "object",
      "required": [
        "agent_ref",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_ref": {
          "$ref": "#/$defs/iri"
        },
        "role": {
          "enum": [
            "applicant",
            "design_professional",
            "intake",
            "authority",
            "system",
            "other"
          ]
        },
        "native_role_label": {
          "type": "string",
          "maxLength": 80
        },
        "classifications": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/classification"
          }
        }
      }
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "purpose": {
      "enum": [
        "initial_submission",
        "resubmittal",
        "evidence_transfer"
      ]
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "representation": {
      "type": "object",
      "required": [
        "media_type",
        "profile"
      ],
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "const": "application/ld+json"
        },
        "profile": {
          "const": "ori-transmission-envelope-0.1"
        }
      }
    },
    "supported_media_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_ref",
          "media_type",
          "sha256",
          "artifact_state",
          "hash_status",
          "representation",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "artifact_ref": {
            "$ref": "#/$defs/iri"
          },
          "media_type": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
          },
          "sha256": {
            "$ref": "#/$defs/sha256OrUnknown"
          },
          "artifact_state": {
            "enum": [
              "available",
              "unrebuilt",
              "unavailable",
              "unknown"
            ]
          },
          "hash_status": {
            "enum": [
              "verified",
              "declared",
              "unknown"
            ]
          },
          "bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "const": "unknown"
              }
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,200}$"
          },
          "source_ifc_ref": {
            "$ref": "#/$defs/iri"
          },
          "geometry_map_status": {
            "enum": [
              "bound",
              "unknown"
            ]
          },
          "geometry_map_ref": {
            "$ref": "#/$defs/iri"
          },
          "wasDerivedFrom": {
            "$ref": "#/$defs/iri"
          },
          "representation": {
            "type": "string",
            "maxLength": 120
          },
          "role": {
            "enum": [
              "source_model",
              "view_model",
              "document",
              "requirement_set",
              "evidence",
              "change_record"
            ]
          },
          "revision_ref": {
            "$ref": "#/$defs/iri"
          },
          "schema_identifier": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,30}$"
          },
          "schema_identifier_verification": {
            "enum": [
              "verified",
              "unknown"
            ]
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "classification",
        "handling",
        "access_scope",
        "retention_ref",
        "redaction_status"
      ],
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "public",
            "restricted",
            "unknown"
          ]
        },
        "handling": {
          "enum": [
            "preserve_declared_controls",
            "restricted_pending_classification"
          ]
        },
        "access_scope": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,60}$"
        },
        "retention_ref": {
          "$ref": "#/$defs/iriOrUnknown"
        },
        "redaction_status": {
          "enum": [
            "declared_redacted",
            "not_redacted",
            "unknown"
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "state",
        "received_at",
        "manifest_verification",
        "application_intake_status",
        "is_approval"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "received",
            "unknown"
          ]
        },
        "received_at": {
          "$ref": "#/$defs/dateTimeOrUnknown"
        },
        "manifest_verification": {
          "enum": [
            "verified",
            "mismatch",
            "unknown"
          ]
        },
        "application_intake_status": {
          "enum": [
            "pending",
            "unknown"
          ]
        },
        "is_approval": {
          "const": false
        },
        "receipt_ref": {
          "$ref": "#/$defs/iri"
        }
      }
    },
    "change_record_ref": {
      "type": "string",
      "pattern": "^urn:ori:change:\\S+$"
    },
    "pre_reviewed_design_ref": {
      "type": "string",
      "pattern": "^urn:ori:prereviewed:\\S+$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "iri": {
      "type": "string",
      "pattern": "^(urn:[a-z0-9-]+:|https?://)\\S+$"
    },
    "iriOrUnknown": {
      "anyOf": [
        {
          "$ref": "#/$defs/iri"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "sha256OrUnknown": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "dateTimeOrUnknown": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "globalId": {
      "type": "string",
      "pattern": "^[0-9A-Za-z_$]{22}$"
    },
    "modelVersion": {
      "$ref": "https://openpermit.dev/spec/ori-review-comment-0.2.schema.json#/$defs/modelVersion"
    },
    "anchor": {
      "$ref": "https://openpermit.dev/spec/ori-review-comment-0.2.schema.json#/$defs/anchor"
    },
    "activity": {
      "type": "object",
      "required": [
        "@id",
        "@type"
      ],
      "additionalProperties": false,
      "properties": {
        "@id": {
          "$ref": "#/$defs/iri"
        },
        "@type": {
          "const": "prov:Activity"
        },
        "used": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/iri"
          },
          "uniqueItems": true
        },
        "wasAssociatedWith": {
          "$ref": "#/$defs/iri"
        }
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "scheme",
        "version",
        "code",
        "source_url",
        "status"
      ],
      "additionalProperties": false,
      "description": "External code-list reference (e.g. NAICS). Code only; titles and tables are not reproduced. Classification is descriptive and never grants authority or licensure.",
      "properties": {
        "scheme": {
          "enum": [
            "naics"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{2,6}$"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "status": {
          "enum": [
            "declared",
            "verified",
            "unknown"
          ]
        }
      }
    },
    "hashRef": {
      "type": "object",
      "required": [
        "artifact_ref",
        "media_type",
        "sha256",
        "artifact_state",
        "hash_status"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/iri"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256OrUnknown"
        },
        "artifact_state": {
          "enum": [
            "available",
            "unrebuilt",
            "unavailable",
            "unknown"
          ]
        },
        "hash_status": {
          "enum": [
            "verified",
            "declared",
            "unknown"
          ]
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": "unknown"
            }
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,200}$"
        }
      },
      "description": "Hash reference to complete saved file bytes. Unrebuilt means no bytes yet: hash unknown, never a content-addressed ID (checked semantically)."
    },
    "viewHashRef": {
      "type": "object",
      "required": [
        "artifact_ref",
        "media_type",
        "sha256",
        "artifact_state",
        "hash_status",
        "source_ifc_ref",
        "geometry_map_status"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/iri"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256OrUnknown"
        },
        "artifact_state": {
          "enum": [
            "available",
            "unrebuilt",
            "unavailable",
            "unknown"
          ]
        },
        "hash_status": {
          "enum": [
            "verified",
            "declared",
            "unknown"
          ]
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": "unknown"
            }
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,200}$"
        },
        "source_ifc_ref": {
          "$ref": "#/$defs/iri"
        },
        "geometry_map_status": {
          "enum": [
            "bound",
            "unknown"
          ]
        },
        "geometry_map_ref": {
          "$ref": "#/$defs/iri"
        },
        "wasDerivedFrom": {
          "$ref": "#/$defs/iri"
        }
      }
    }
  }
}
