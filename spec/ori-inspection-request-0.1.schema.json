{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpermit.dev/spec/ori-inspection-request-0.1.schema.json",
  "title": "ORI Inspection Request v0.1 Draft",
  "description": "A portable request for a jurisdiction inspection on an issued permit, and the attributable events that follow it. A request is not approval and does not schedule anything by itself: the jurisdiction's system remains the authority for availability, scheduling and results. Source-native inspection codes and statuses are preserved; mapped values are assertions. See spec/inspection-request-0.1-draft.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/inspectionRequest"
    },
    {
      "$ref": "#/$defs/inspectionEvent"
    }
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "nativeTerm": {
      "description": "A term exactly as the jurisdiction's system states it, optionally with a mapping assertion to a shared concept.",
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "mapping": {
          "$ref": "#/$defs/ref"
        }
      },
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      },
      "additionalProperties": false
    },
    "inspectionRequest": {
      "type": "object",
      "required": [
        "profile",
        "kind",
        "label",
        "request_id",
        "idempotency_key",
        "created_at",
        "jurisdiction",
        "permit",
        "inspection_type",
        "site",
        "requested_window",
        "requester",
        "readiness"
      ],
      "properties": {
        "profile": {
          "const": "ori-inspection-request-0.1"
        },
        "kind": {
          "const": "InspectionRequest"
        },
        "label": {
          "const": "Request, not approval"
        },
        "request_id": {
          "type": "string",
          "pattern": "^urn:ori:inspection-request:"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "jurisdiction": {
          "$ref": "#/$defs/ref"
        },
        "permit": {
          "type": "object",
          "required": [
            "authority_permit_number"
          ],
          "properties": {
            "authority_permit_number": {
              "type": "string",
              "minLength": 1
            },
            "permit_ref": {
              "$ref": "#/$defs/ref"
            }
          },
          "additionalProperties": false
        },
        "inspection_type": {
          "type": "object",
          "required": [
            "native"
          ],
          "properties": {
            "native": {
              "$ref": "#/$defs/nativeTerm"
            },
            "requirement_ref": {
              "$ref": "#/$defs/ref"
            }
          },
          "additionalProperties": false
        },
        "site": {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "address"
              ]
            },
            {
              "required": [
                "parcel_id"
              ]
            }
          ],
          "properties": {
            "address": {
              "type": "string",
              "minLength": 1
            },
            "parcel_id": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "type": "string"
            },
            "spatial_anchor": {
              "$ref": "#/$defs/ref"
            }
          },
          "additionalProperties": false
        },
        "requested_window": {
          "type": "object",
          "required": [
            "earliest_date"
          ],
          "properties": {
            "earliest_date": {
              "type": "string",
              "format": "date"
            },
            "latest_date": {
              "type": "string",
              "format": "date"
            },
            "time_of_day": {
              "enum": [
                "am",
                "pm",
                "any"
              ]
            },
            "method": {
              "enum": [
                "request",
                "ready_by",
                "slot"
              ],
              "description": "request = a preferred date the authority may move; ready_by = work ready from this date, authority picks; slot = a specific slot offered by the authority's availability query."
            }
          },
          "additionalProperties": false
        },
        "modality": {
          "enum": [
            "in_person",
            "remote_virtual",
            "third_party"
          ],
          "default": "in_person"
        },
        "third_party_inspector": {
          "description": "Required when modality is third_party: the credential chain from spec/evidence-attestation-0.1-draft.md.",
          "type": "object",
          "required": [
            "credential_ref",
            "inspector"
          ],
          "properties": {
            "credential_ref": {
              "$ref": "#/$defs/ref"
            },
            "inspector": {
              "$ref": "#/$defs/contact"
            }
          },
          "additionalProperties": false
        },
        "requester": {
          "type": "object",
          "required": [
            "role",
            "contact"
          ],
          "properties": {
            "role": {
              "enum": [
                "permit_holder",
                "contractor",
                "owner",
                "agent"
              ]
            },
            "contact": {
              "$ref": "#/$defs/contact"
            },
            "license_number": {
              "type": "string"
            },
            "on_behalf_of": {
              "$ref": "#/$defs/ref"
            }
          },
          "additionalProperties": false
        },
        "site_access": {
          "description": "How the inspector gets in. Access secrets (lockbox or gate codes) are never carried here; reference a secured channel instead.",
          "type": "object",
          "properties": {
            "on_site_contact": {
              "$ref": "#/$defs/contact"
            },
            "instructions": {
              "type": "string",
              "maxLength": 500
            },
            "access_secret_ref": {
              "$ref": "#/$defs/ref"
            }
          },
          "additionalProperties": false
        },
        "readiness": {
          "description": "The requester's attestation that the work is ready. An assertion, not a fact.",
          "type": "object",
          "required": [
            "statement",
            "attested_by",
            "attested_at"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "attested_by": {
              "$ref": "#/$defs/ref"
            },
            "attested_at": {
              "type": "string",
              "format": "date-time"
            },
            "prerequisite_inspections": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ref"
              },
              "uniqueItems": true
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ref"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "source_system": {
          "$ref": "#/$defs/ref"
        },
        "reinspection_of": {
          "type": "string",
          "pattern": "^urn:ori:inspection-request:"
        },
        "callback_url": {
          "type": "string",
          "format": "uri",
          "description": "Where the authority's system posts InspectionEvents. Optional; polling remains valid."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "modality": {
                "const": "third_party"
              }
            },
            "required": [
              "modality"
            ]
          },
          "then": {
            "required": [
              "third_party_inspector"
            ]
          }
        }
      ]
    },
    "inspectionEvent": {
      "type": "object",
      "required": [
        "profile",
        "kind",
        "event_id",
        "request_id",
        "status",
        "native_status",
        "occurred_at",
        "recorded_by"
      ],
      "properties": {
        "profile": {
          "const": "ori-inspection-request-0.1"
        },
        "kind": {
          "const": "InspectionEvent"
        },
        "event_id": {
          "type": "string",
          "pattern": "^urn:ori:inspection-event:"
        },
        "request_id": {
          "type": "string",
          "pattern": "^urn:ori:inspection-request:"
        },
        "authority_inspection_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "requested",
            "acknowledged",
            "scheduled",
            "rescheduled",
            "declined",
            "cancelled",
            "completed",
            "unknown"
          ]
        },
        "native_status": {
          "$ref": "#/$defs/nativeTerm"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_by": {
          "$ref": "#/$defs/ref"
        },
        "scheduled_window": {
          "type": "object",
          "required": [
            "date"
          ],
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "start_time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "end_time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          },
          "additionalProperties": false
        },
        "inspector": {
          "$ref": "#/$defs/contact"
        },
        "result": {
          "enum": [
            "approved",
            "approved_with_conditions",
            "disapproved",
            "partial",
            "not_ready",
            "not_performed"
          ]
        },
        "native_result": {
          "$ref": "#/$defs/nativeTerm"
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        },
        "supersedes": {
          "type": "string",
          "pattern": "^urn:ori:inspection-event:"
        },
        "final": {
          "type": "boolean",
          "description": "True when this result closes the inspection type for the permit (BLDS Final)."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "required": [
              "result",
              "native_result"
            ]
          },
          "else": {
            "not": {
              "required": [
                "result"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "scheduled",
                  "rescheduled"
                ]
              }
            }
          },
          "then": {
            "required": [
              "scheduled_window"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "declined",
                  "cancelled"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "disapproved",
                  "partial",
                  "approved_with_conditions"
                ]
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "required": [
              "corrections"
            ]
          }
        }
      ]
    }
  }
}
