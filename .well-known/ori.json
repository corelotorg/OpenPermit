  "capability_registry": "https://github.com/corelotorg/OpenPermit/blob/test/spec/capability-registry-0.1-draft.md",
  "guidance_profiles": [
    "https://github.com/corelotorg/OpenPermit/blob/test/profiles/federal/hud-home-construction-best-practices-2026.json",
    "https://github.com/corelotorg/OpenPermit/blob/test/profiles/federal/regulatory-inventory-2025.json"
  ],
  "project_target_profiles": [
    "https://github.com/corelotorg/OpenPermit/blob/test/profiles/project/ori-sf-review-target-24h-2026.json"
  ],
  "example_jurisdiction_inventories": [
    "https://github.com/corelotorg/OpenPermit/blob/test/profiles/examples/example-city/residential-new-construction-example.json"
  ],
  "conformance": {
    "repository": "https://github.com/corelotorg/OpenPermit/tree/test/conformance",
    "command": "python conformance/validate.py",
    "negative_semantic_fixtures": "https://github.com/corelotorg/OpenPermit/tree/test/conformance/negative"
  },
  "interfaces": {
    "mcp": {
      "status": "reference-node-source-published",
      "transport": "streamable-http",
      "path": "/mcp",
      "source": "https://github.com/corelotorg/OpenPermit/tree/test/reference-node",
      "operations": [
        "ori.capabilities",
        "ori.get",
        "ori.traverse",
        "ori.provenance",
        "ori.verify",
        "ori.analyze_precedence",
        "ori.challenge",
        "ori.resolve_challenge",
        "ori.list_profiles"
      ]
    },
    "rest": {
      "status": "reference-node-source-published",
      "health_path": "/health",
      "discovery_path": "/.well-known/ori.json"
    },
    "json_ld": true,
    "static_http": true
  },
  "principles": [
    "permissionless",
    "source-preserving",
    "jurisdiction-aware",
    "graph-native",
    "challengeable",
    "testable",
    "model-native",
    "vendor-neutral",
    "authority-preserving",
    "runnable"
  ],
  "legal_boundary": "Guidance-profile alignment and model/validator output are not determinations of legal compliance, local legal obligation, professional authority, regulatory approval, or government endorsement.",
  "scope": "Detached single-family new homes; 2021 IRC base with the 2021 Virginia Residential Code as the first override layer.",
  "guardrails": [
    "A machine check is never approval.",
    "Unknown is not fail.",
    "Building-code text is cited and linked, never reproduced.",
    "Guidance is not law."
  ],
  "licenses": {
    "code": "Apache-2.0",
    "prose": "CC-BY-SA-4.0 (files previously dedicated CC0 stay CC0)",
    "schemas_vocab_data_fixtures": "CC0-1.0",
    "map": "https://github.com/corelotorg/OpenPermit/blob/test/LICENSE-SPEC.md"
  },
  "governance_boundary": "https://github.com/corelotorg/OpenPermit/blob/test/docs/GOVERNANCE-BOUNDARY.md",
  "model_verification": {
    "name": "OpenPermit Model Verification",
    "status": "research-and-reference-assemblies",
    "route": "model-verification/"
  }
