{
  "id": "https://openpermit.dev/",
  "name": "OpenPermit",
  "standard": "Open Regulatory Infrastructure",
  "version": "0.1.0-draft",
  "status": "public-working-draft",
  "site_hosting": {
    "status": "release-prepared",
    "note": "Public-site routes are built from site/routes.json; domain cutover and deployment require separate receipts.",
    "route_manifest": "site/routes.json"
  },
  "domains": {
    "openpermit.io": {
      "role": "project",
      "status": "pending"
    },
    "openpermit.dev": {
      "role": "developers-spec-benchmark; schema $id host",
      "status": "pending"
    }
  },
  "canonical_repository": "https://github.com/corelotorg/OpenPermit",
  "published_branch": "test",
  "charter": "https://github.com/corelotorg/OpenPermit/blob/test/CHARTER.md",
  "core_spec": "https://github.com/corelotorg/OpenPermit/blob/test/spec/ori-core-0.1-draft.md",
  "schema": "https://github.com/corelotorg/OpenPermit/blob/test/spec/ori-core-0.1.schema.json",
  "guidance_schema": "https://github.com/corelotorg/OpenPermit/blob/test/spec/ori-guidance-profile-0.1.schema.json",
  "jurisdiction_inventory_schema": "https://github.com/corelotorg/OpenPermit/blob/test/spec/ori-jurisdiction-inventory-0.1.schema.json",
  "model_interface": "https://github.com/corelotorg/OpenPermit/blob/test/spec/model-interface-0.1-draft.md",
  "precedence_graph": "https://github.com/corelotorg/OpenPermit/blob/test/spec/precedence-graph-0.1-draft.md",
  "challenge_protocol": "https://github.com/corelotorg/OpenPermit/blob/test/spec/challenge-protocol-0.1-draft.md",
